{
  "schemaVersion": 1,
  "id": "tryitout",
  "version": "${version}",
  "name": "TryItOut",
  "description": "A pocket test room: preview any block or item in an isolated live scene without leaving your world. With the mod on the server too, a separate test world can be used.",
  "authors": [
    "ufuk"
  ],
  "license": "MPL-2.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ufuk.tryitout.fabric.TryItOutFabricMain"
    ],
    "client": [
      "com.ufuk.tryitout.fabric.TryItOutFabric"
    ],
    "jei_mod_plugin": [
      "com.ufuk.tryitout.compat.jei.TryItOutJeiPlugin"
    ],
    "emi": [
      "com.ufuk.tryitout.compat.emi.TryItOutEmiPlugin"
    ]
  },
  "mixins": [
    "tryitout.mixins.json",
    "tryitout-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.0",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*",
    "emi": "*"
  }
}