{
  "schemaVersion": 1,
  "id": "pocketsandbox",
  "version": "${version}",
  "name": "Test Room",
  "description": "A pocket test room: preview any block or item in an isolated live scene without leaving your world. With the mod on the server too, a separate test world can be used.",
  "authors": [
    "ufuk"
  ],
  "license": "MPL-2.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ufuk.pocketsandbox.fabric.PocketSandboxFabricMain"
    ],
    "client": [
      "com.ufuk.pocketsandbox.fabric.PocketSandboxFabric"
    ],
    "jei_mod_plugin": [
      "com.ufuk.pocketsandbox.compat.jei.PocketSandboxJeiPlugin"
    ],
    "emi": [
      "com.ufuk.pocketsandbox.compat.emi.PocketSandboxEmiPlugin"
    ]
  },
  "mixins": [
    "pocketsandbox.mixins.json",
    "pocketsandbox-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.0",
    "fabric-api": "*"
  },
  "suggests": {
    "jei": "*",
    "emi": "*"
  }
}